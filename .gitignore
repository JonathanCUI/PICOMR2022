# ================================================ #
#                  Unity .gitignore                  #
# ================================================ #

# --------------- [ General OS ] --------------- #
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Visual Studio / Rider cache
.vs/
*.csproj
*.sln
.idea/
*.sln.DotSettings.user

# VS Code
.vscode/

# --------------- [ Unity Generated ] --------------- #
# Meta files for empty directories
!Assets/**/*.meta
!Packages/**/*.meta
!ProjectSettings/**/*.meta

# Crashlytics
crashlytics-build.properties

# Asset Store Tools
Assets/AssetStoreTools*

# --------------- [ Autogenerated Assets ] --------------- #
# NavMesh
*.navMesh

# Lightmap (no mixed)
*_LightmapData.asset

# --------------- [ OS generated ] --------------- #
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --------------- [ Package Manager ] --------------- #
# Ignore files in Packages but keep manifests
Packages/*
!Packages/manifest.json
!Packages/packages-lock.json

# --------------- [ Sensitive Files ] --------------- #
# Keystore files
*.keystore
*.keystore.meta
user.keystore

# Credentials
*Credentials.*
*credentials.*

# --------------- [ Memory Captures ] --------------- #
*.memo
*.memo.meta

# --------------- [ Asset Server ] --------------- #
Assets/AssetServer.txt
